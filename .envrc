#  works with direnv 2.32.1 on Ubuntu/GNU
dotenv_if_exists .env

# (Or, if you don’t want the plugin, you can do the same by hand:)
# if [ -f .env ]; then
#   source_env .env
# fi

if ! ./cookie-store validate; then
  echo "⚠️  Old cookie ... refresh or fetch token …"
  ./cookie-store refresh
fi

eval "$(./cookie-store export)"
