#!/usr/bin/env bash

TOKENFILE=".session-token.txt"
COOKIES_FILE="cookies.json"

if [[ -n $DEBUG ]]; then
    set -x
fi

main(){
    local value
    trap handle-exit EXIT 

    case "$1" in 
        self-test) self-test
            ;;
        refresh)
            value="$(./fetch-or-refresh-session-token)"
            persist "$value"
            ;;
        delete) delete;
            ;;
        persist) 
            shift
            persist "$@"
            ;;
        validate) 
            invalidate-old
            ;;
        export) do-export
            ;;
        *) 
            usage 
            exit 1
            ;;
    esac
}

# no-op, exit in tests, where it is overwritten for teardown
handle-exit(){
    :
}

delete-tokenfile(){
    rm -f "$TOKENFILE"
    if [[ -e "$TOKENFILE".bak ]]; then
        mv "$TOKENFILE"{.bak,}
    fi
}

persist(){
    if [ -z "$1" ]; then
        error "Nothing to persist. No argument received"
    fi
    echo "$@" > "$TOKENFILE"
}

# exit status:
# 1 if invalid or invalid
invalidate-old(){
    # invalidate any cookie older than six hours
    if  [[ $(find . -mmin -60 -name "$TOKENFILE" -print -quit) == '' ]]; then
        delete-tokenfile
        return 1
    fi
}

do-export(){
    local session
    local aktivTilbyder
    local herokuAffinity

    if [[ ! -e "$TOKENFILE" ]]; then
        error "No cookie stored."
    fi

    session=$(cat "$TOKENFILE")
    local aktivTilbyderFromCookie=""
    if [[ -f "$COOKIES_FILE" ]]; then
        aktivTilbyderFromCookie="$(jq -r '.[] | select(.name=="aktivTilbyder") | .value' "$COOKIES_FILE" | tail -n 1)"
    fi

    if [[ -n "$INATUR_AKTIVTILBYDER" ]]; then
        aktivTilbyder="$INATUR_AKTIVTILBYDER"
    elif [[ -n "$aktivTilbyderFromCookie" ]]; then
        aktivTilbyder="$aktivTilbyderFromCookie"
    fi

    if [[ -n "$INATUR_AKTIVTILBYDER" && -n "$aktivTilbyderFromCookie" && "$INATUR_AKTIVTILBYDER" != "$aktivTilbyderFromCookie" ]]; then
        echo "warning: INATUR_AKTIVTILBYDER=${INATUR_AKTIVTILBYDER} differs from cookies.json aktivTilbyder=${aktivTilbyderFromCookie}" >&2
    fi

    if [[ -z "$aktivTilbyder" ]]; then
        error "Could not determine aktivTilbyder. Set INATUR_AKTIVTILBYDER and try again."
    fi

    if [[ -f "$COOKIES_FILE" ]]; then
        herokuAffinity="$(jq -r '.[] | select(.name=="heroku-session-affinity") | .value' "$COOKIES_FILE" | tail -n 1)"
    fi

    if [[ -n "$herokuAffinity" ]]; then
        echo "export INATUR_COOKIE='session=$session; heroku-session-affinity=$herokuAffinity; aktivTilbyder=$aktivTilbyder'"
    else
        echo "export INATUR_COOKIE='session=$session; aktivTilbyder=$aktivTilbyder'"
    fi
}

error(){
        echo "$@" >&2
        exit 1
}

self-test(){
    assert(){
        if [[ $# != 2 ]]; then 
            echo "assert() requires 2 args: <test> <msg>"
            exit 1
        fi
        if ! eval "$1"; then 
            shift
            echo "$@"
            exit 1
        fi
    }
    test_invalidate(){
        rm -f "$TOKENFILE"
        assert '! invalidate-old' 'Expected to fail on missing tokenfile'

        touch "$TOKENFILE"
        assert 'invalidate-old'   'Expected not to fail on new tokenfile'
    }

    handle-exit(){
        delete-tokenfile
    }

    # run tests
    if [[ -e "$TOKENFILE" ]]; then
        mv "$TOKENFILE"{,.bak}
    fi

    test_invalidate
}

usage(){
    echo
    echo "USAGE: $0 <option> [argument]"
    echo "  where <option> is one of "
    echo '
    export              Prints the INATUR_COOKIE as an export statement for "eval" 
    validate            OK if < 1h old cookie, else exit status of 1
    persist <cookie>    Will persist the session cookie
    delete              Force delete. Typical on a 401
    refresh             refresh the session cookie
    self-test           Run built-in tests
    '
}

main "$@"
