#!/usr/bin/env node
const { chromium } = require("playwright");
const debug = require("debug")("fetch-cookie");
const startTime = Date.now();

function usage() {
  console.log(`USAGE: ${process.argv[1]} 
    Will output the relevant cookies
        `);

  process.exit(1);
}
const user = process.env.INATUR_USER;
const pass = process.env.INATUR_PASSWORD;
if (!user || !pass) {
  console.error("set INATUR_USER and INATUR_PASSWORD");
  usage();
}
if (process.argv.length > 2) usage();

(async () => {
  const browser = await chromium.launch({ headless: true });
  const ctx = await browser.newContext();
  const page = await ctx.newPage();

  debug("1) Go to inatur login");
  await page.goto("https://www.inatur.no/login", { waitUntil: "networkidle" });
  debug("   landed on:", page.url());

  debug("2) Wait for Keycloak form to appear");
  await page.waitForSelector('input[name="username"]', { timeout: 10000 });

  debug("3) Fill credentials");
  await page.fill('input[name="username"]', user);
  await page.fill('input[name="password"]', pass);

  debug("4) Submit and wait for navigation");
  await Promise.all([
    page.click('button[type="submit"]'),
    page.waitForNavigation({ waitUntil: "networkidle", timeout: 15000 }),
  ]);
  debug("   after submit, url is:", page.url());

  debug("5) Wait for final /min-side");
  await page.waitForURL("https://www.inatur.no/min-side**", {
    timeout: 15000,
    waitUntil: "networkidle",
  });
  debug("   logged in at:", page.url());

  debug("6) Dump cookies");
  const cookies = await ctx.cookies();
  let session = null;
  for (const c of cookies) {
    debug(`Cookie: ${c.name}=${c.value}`);
    if (c.name === "session") session = c.value;
  }

  const duration = Date.now() - startTime;
  console.log(session);
  debug(`Duration: ${duration} ms`);

  await browser.close();
})();
